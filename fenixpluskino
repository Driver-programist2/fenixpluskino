const http = require('http');
const https = require('https');

// Порт, на котором будет работать ваш локальный сервер для VLC
const PORT = 3000; 

// Функция для парсинга страницы и поиска актуального потока
function getLiveStreamUrl() {
    return new Promise((resolve, reject) => {
        https.get('https://telik.live/feniks-kino.html', {
            headers: {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
                'Referer': 'https://telik.live'
            }
        }, (res) => {
            let data = '';
            res.on('data', chunk => data += chunk);
            res.on('end', () => {
                // Ищем в коде страницы регулярным выражением ссылку на m3u8
                const match = data.match(/https:\/\/tvcdnpotok\.com\/[---]+\/\d+\/\d+\/index\.m3u8/);
                if (match) {
                    resolve(match[0]);
                } else {
                    reject('Поток не найден на странице. Возможно, изменилась структура сайта.');
                }
            });
        }).on('error', (err) => reject(err));
    });
}

// Создаем HTTP-сервер, к которому будет подключаться VLC
const server = http.createServer(async (req, res) => {
    if (req.url === '/index.m3u8') {
        try {
            console.log('[Parser] VLC запросил поток. Ищу актуальную ссылку...');
            const realStreamUrl = await getLiveStreamUrl();
            console.log(`[Parser] Свежий поток найден: ${realStreamUrl}`);
            
            // Отправляем VLC временное перенаправление (302 Redirect) на актуальный поток с новым токеном
            res.writeHead(302, { 'Location': realStreamUrl });
            res.end();
        } catch (error) {
            console.error(`[Error] ${error}`);
            res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
            res.end('Ошибка при получении потока.');
        }
    } else {
        res.writeHead(404);
        res.end();
    }
});

server.listen(PORT, () => {
    console.log(`====================================================`);
    console.log(` Сервер-транслятор успешно запущен!`);
    console.log(` Вставьте эту ссылку в VLC плеер (CTRL+N):`);
    console.log(`====================================================`);
});
